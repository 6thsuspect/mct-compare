{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@mct/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@mct/parser": ["../../packages/mct-parser/src/index.ts"],
      "@mct/diff": ["../../packages/mct-diff/src/index.ts"],
      "@mct/converter": ["../../packages/mct-converter/src/index.ts"],
      "@mct/validation": ["../../packages/mct-validation/src/index.ts"]
