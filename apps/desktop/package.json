    "dev": "npm run build && electron ."
  },
  "dependencies": {
    "@mct/shared-types": "0.1.0",
    "@mct/parser": "0.1.0",
    "@mct/diff": "0.1.0",
    "@mct/converter": "0.1.0",
    "@mct/validation": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
