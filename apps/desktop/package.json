{
  "name": "@mct/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "MCT Diff Studio Windows desktop application (Electron)",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
